<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.epsgrau.pe</groupId>
	<artifactId>sicodetri</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>sicodetri</name>
	<description>Sismtema de conciliacion Tributaria vs Financiera de Activos Fijos</description>

	<developers>
		<developer>
			<id>carlosnole</id>
			<name>Carlos Nole</name>
			<email>ing.inf.cnolem@outlook.com</email>
			<organization>FREELANCE</organization>
			<timezone>America/Lima</timezone>
			<roles>
				<role>Software Developer</role>
			</roles>
		</developer>
	</developers>

	<properties>
		<java.version>17</java.version>

		<!-- Librerías -->
		<apache.poi.version>5.3.0</apache.poi.version>
		<mockito.core.version>5.3.1</mockito.core.version>
		<mockito.inline.version>5.2.0</mockito.inline.version>
		<jacoco.version>0.8.8</jacoco.version>
		<springdoc.openapi.version>2.3.0</springdoc.openapi.version>
		<itext.core.version>8.0.2</itext.core.version>
		<postgresql.version>42.7.2</postgresql.version>
		<jasperreports.version>6.21.3</jasperreports.version>
		<google.guava.version>30.1-jre</google.guava.version>
		<spotbugs.annotations.version>4.0.0</spotbugs.annotations.version>
		<karate.version>1.4.0</karate.version>
		<spring-authorization-server.version>1.1.0</spring-authorization-server.version>

		<!-- Plugins de calidad -->
		<plugin.maven.checkstyle.version>3.3.1</plugin.maven.checkstyle.version>
		<plugin.maven.spotbugs.version>4.8.6.6</plugin.maven.spotbugs.version>
		<plugin.maven.javadoc.version>3.4.1</plugin.maven.javadoc.version>

		<!-- JMeter -->
		<jmeter.maven.plugin.version>3.8.0</jmeter.maven.plugin.version>
		<jmeter.version>5.6.3</jmeter.version>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
		</dependency>

		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>${apache.poi.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.openapi.version}</version>
		</dependency>

		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>itext-core</artifactId>
			<version>${itext.core.version}</version>
			<type>pom</type>
		</dependency>

		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports</artifactId>
			<version>${jasperreports.version}</version>
		</dependency>
		<dependency>
			<groupId>net.sf.jasperreports</groupId>
			<artifactId>jasperreports-fonts</artifactId>
			<version>${jasperreports.version}</version>
		</dependency>

		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>${google.guava.version}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>com.github.spotbugs</groupId>
			<artifactId>spotbugs-annotations</artifactId>
			<version>${spotbugs.annotations.version}</version>
			<scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>${mockito.core.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-inline</artifactId>
			<version>${mockito.inline.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>com.intuit.karate</groupId>
			<artifactId>karate-junit5</artifactId>
			<version>${karate.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Spring Security Core -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Resource Server (para validar JWT en tus APIs) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- Authorization Server -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-authorization-server</artifactId>
			<version>${spring-authorization-server.version}</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>repackage</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<excludes>
								<exclude>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Javadoc -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${plugin.maven.javadoc.version}</version>
				<executions>
					<execution>
						<id>generate-javadoc</id>
						<goals>
							<goal>javadoc</goal>
						</goals>
						<phase>verify</phase>
					</execution>
					<execution>
						<id>attach-javadoc-jar</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- Codificación para que reconozca acentos y símbolos -->
					<encoding>${project.build.sourceEncoding}</encoding>
					<docencoding>${project.build.sourceEncoding}</docencoding>
					<charset>UTF-8</charset>
					<!-- Genera todos los niveles de visibilidad si lo deseas -->
					<show>private</show>
				</configuration>
			</plugin>

			<!-- JaCoCo -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Checkstyle -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${plugin.maven.checkstyle.version}</version>
				<configuration>
					<!-- Ruta a tu archivo checkstyle.xml -->
					<configLocation>checkstyle.xml</configLocation>
					<!-- Mostrar salida en consola -->
					<consoleOutput>true</consoleOutput>
					<!-- Hacer que falle incluso con violaciones de nivel “error” -->
					<failsOnError>true</failsOnError>
					<!-- Hacer que falle incluso con violaciones de nivel “warning” -->
					<failOnViolation>true</failOnViolation>
					<!-- Nivel mínimo de severidad que consideraremos para fallar el build -->
					<violationSeverity>warning</violationSeverity>
				</configuration>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- SpotBugs -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${plugin.maven.spotbugs.version}</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<xmlOutput>true</xmlOutput>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Failsafe (ITs Karate) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- Activa el perfil 'integration' durante los ITs -->
					<systemPropertyVariables>
						<spring.profiles.active>integration</spring.profiles.active>
					</systemPropertyVariables>
					<!-- Detecta tests con sufijo *IT.java -->
					<includes>
						<include>**/AllKarateFeaturesIT.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Perfil para pruebas de performance con JMeter -->
	<profiles>
		<profile>
			<id>performance</id>
			<build>
				<resources>
					<resource>
						<directory>${project.basedir}/src/test/jmeter/datasets</directory>
						<includes>
							<include>**/*.csv</include>
						</includes>
						<targetPath>${project.build.directory}/jmeter/testFiles</targetPath>
					</resource>
				</resources>
				<plugins>
					<plugin>
						<groupId>com.lazerycode.jmeter</groupId>
						<artifactId>jmeter-maven-plugin</artifactId>
						<version>${jmeter.maven.plugin.version}</version>
						<configuration>
							<jmeterVersion>${jmeter.version}</jmeterVersion>
						</configuration>
						<executions>
							<execution>
								<id>configuration</id>
								<goals>
									<goal>configure</goal>
								</goals>
							</execution>
							<execution>
								<id>jmeter-tests</id>
								<goals>
									<goal>jmeter</goal>
								</goals>
								<configuration>
									<testFilesIncluded>
										<jMeterTestFile>${testFiles}</jMeterTestFile>
									</testFilesIncluded>
									<propertiesUser>
										<host>${host}</host>
										<port>${port}</port>
										<protocol>${protocol}</protocol>
										<base_api>${base_api}</base_api>
										<users>${users}</users>
										<rampup>${rampup}</rampup>
										<duration>${duration}</duration>
										<pct_upload_save>${pct.upload.save}</pct_upload_save>
										<pct_query>${pct.query}</pct_query>
										<pct_proj>${pct.proj}</pct_proj>
										<pct_report>${pct.report}</pct_report>
										<pct_tax>${pct.tax}</pct_tax>
									</propertiesUser>
									<generateReports>true</generateReports>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<skip>true</skip>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<skipITs>true</skipITs>
							<skipTests>true</skipTests>
						</configuration>
					</plugin>
					<plugin>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs-maven-plugin</artifactId>
						<configuration>
							<skip>true</skip>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<configuration>
							<skip>true</skip>
						</configuration>
					</plugin>
				</plugins>
			</build>
			<properties>
				<host>localhost</host>
				<port>8082</port>
				<protocol>http</protocol>
				<base_api>/api/v1</base_api>
				<users>20</users>
				<rampup>60</rampup>
				<duration>300</duration>
				<testFiles>SICODETRI_LoadTest.jmx</testFiles>
				<pct.upload.save>10</pct.upload.save>
				<pct.query>40</pct.query>
				<pct.proj>15</pct.proj>
				<pct.report>20</pct.report>
				<pct.tax>15</pct.tax>
			</properties>
		</profile>
	</profiles>
	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${plugin.maven.checkstyle.version}</version>
				<configuration>
					<configLocation>checkstyle.xml</configLocation>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${plugin.maven.spotbugs.version}</version>
			</plugin>
		</plugins>
	</reporting>
</project>