<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SICODETRI Load Test - Secuencial por usuario (fixed)">
      <stringProp name="TestPlan.comments">Secuencia: CSV row -> Upload -> Save (con retry 417 temporal) -> Projection (con retry 417 temporal). Candado opcional via -Dglobal_sequential=true. CSV: stopThread=true y recycle=false para evitar &lt;EOF&gt; en variables.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <!-- HTTP Defaults -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,8082)}</stringProp>
        <stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
        <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
        <intProp name="HTTPSampler.connect_timeout">10000</intProp>
        <intProp name="HTTPSampler.response_timeout">30000</intProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- Thread Group -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Flujo - Secuencial por CSV">
        <stringProp name="ThreadGroup.num_threads">${__P(users,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,1)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,60)}</stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- HTTP Cookie Manager (único) -->
        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager">
          <collectionProp name="CookieManager.cookies"/>
          <boolProp name="CookieManager.clearEachIteration">false</boolProp>
          <stringProp name="CookieManager.policy">standard</stringProp>
        </CookieManager>
        <hashTree/>

        <!-- Header Defaults -->
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Defaults">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Accept</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>

        <!-- CSV Data Set (FORZADO: recycle=false, stopThread=true) -->
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set - Flujos de Prueba">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(files_dir,)}/flujos.csv</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">false</boolProp>
          <stringProp name="shareMode">shareMode.current_thread</stringProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="variableNames">flow_name,excel_file,period,projection_type,account</stringProp>
        </CSVDataSet>
        <hashTree/>

        <!-- Guard: si CSV devolvió &lt;EOF&gt; en alguna variable clave, parar hilo -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF any &lt;EOF&gt; → Stop Thread">
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <stringProp name="IfController.condition">'&lt;EOF&gt;'.equals(vars.get('flow_name')) || '&lt;EOF&gt;'.equals(vars.get('excel_file')) || '&lt;EOF&gt;'.equals(vars.get('period')) || '&lt;EOF&gt;'.equals(vars.get('projection_type')) || '&lt;EOF&gt;'.equals(vars.get('account'))</stringProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Stop Thread (EOF detected)">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
SampleResult.setSuccessful(true)
log.warn('EOF detected in CSV variables. Stopping thread gracefully.')
org.apache.jmeter.threads.JMeterContextService.getContext().getThread().stop()
]]></stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>

        <!-- AUTH - Once -->
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="AUTH - Once Only"/>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="AUTH - Get Token">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>

            <AuthManager guiclass="AuthPanel" testclass="AuthManager" testname="HTTP Authorization Manager (Basic /oauth2/token)">
              <collectionProp name="AuthManager.auth_list">
                <elementProp name="" elementType="Authorization">
                  <stringProp name="Authorization.url">${__P(protocol,http)}://${__P(host,localhost)}:${__P(port,8082)}${__P(token_path,/oauth2/token)}</stringProp>
                  <stringProp name="Authorization.username">${__P(client_id,perf-client)}</stringProp>
                  <stringProp name="Authorization.password">${__P(client_secret,perf-secret)}</stringProp>
                  <stringProp name="Authorization.domain"></stringProp>
                  <stringProp name="Authorization.realm"></stringProp>
                  <stringProp name="Authorization.mechanism">BASIC</stringProp>
                </elementProp>
              </collectionProp>
              <boolProp name="AuthManager.clearEachIteration">true</boolProp>
            </AuthManager>
            <hashTree/>

            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Get Token (client_credentials)">
              <stringProp name="HTTPSampler.path">${__P(token_path,/oauth2/token)}</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
              <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
              <intProp name="HTTPSampler.connect_timeout">10000</intProp>
              <intProp name="HTTPSampler.response_timeout">30000</intProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="grant_type" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">client_credentials</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">grant_type</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header - Token Request">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/x-www-form-urlencoded</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 2xx (Token)">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="assert_2xx">^2\d\d$</stringProp>
                </collectionProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
              <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Max Response Time (Token)">
                <stringProp name="DurationAssertion.duration">${__P(max_resp_ms,12000)}</stringProp>
              </DurationAssertion>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract ACCESS_TOKEN">
                <stringProp name="JSONPostProcessor.referenceNames">ACCESS_TOKEN</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp>
                <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
              </JSONPostProcessor>
              <hashTree/>
              <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If no ACCESS_TOKEN → Stop">
                <boolProp name="IfController.evaluateAll">false</boolProp>
                <stringProp name="IfController.condition">${__groovy((vars.get('ACCESS_TOKEN') ?: 'TOKEN_NOT_FOUND') == 'TOKEN_NOT_FOUND')}</stringProp>
                <boolProp name="IfController.useExpression">true</boolProp>
              </IfController>
              <hashTree>
                <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Stop Test Now">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
SampleResult.setSuccessful(false)
log.error('ACCESS_TOKEN not found. Stopping test.')
org.apache.jmeter.engine.StandardJMeterEngine.stopTest(true)
]]></stringProp>
                </JSR223Sampler>
                <hashTree/>
              </hashTree>
            </hashTree>

          </hashTree>
        </hashTree>

        <!-- BUSINESS -->
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="BUSINESS - Flujo ${flow_name}">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>

          <!-- Bearer para el subárbol -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header - API Auth (subtree)">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${ACCESS_TOKEN}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <!-- Candado global (opcional via -Dglobal_sequential=true) -->
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF global_sequential=true → Acquire lock">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <stringProp name="IfController.condition">${__groovy((props.getProperty('global_sequential') ?: 'true').toBoolean())}</stringProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GLOBAL LOCK - Acquire">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
import java.util.concurrent.Semaphore
def obj = props.get('perf.global.lock')
Semaphore sem = (obj instanceof Semaphore) ? (Semaphore)obj : null
if (sem == null) {
  sem = new Semaphore(1, true)
  props.put('perf.global.lock', sem)
}
sem.acquire()
vars.put('GLOBAL_LOCK_ACQUIRED','true')
SampleResult.setSuccessful(true)
]]></stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>

          <!-- 1) UPLOAD -->
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Upload Excel (multipart)">
            <stringProp name="HTTPSampler.path">${__P(base_api,/api/v1)}/financial-fixed-assets/upload</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
            <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <intProp name="HTTPSampler.connect_timeout">10000</intProp>
            <intProp name="HTTPSampler.response_timeout">30000</intProp>
            <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
              <collectionProp name="HTTPFileArgs.files">
                <elementProp name="${__P(files_dir,)}/${excel_file}" elementType="HTTPFileArg">
                  <stringProp name="File.path">${__P(files_dir,)}/${excel_file}</stringProp>
                  <stringProp name="File.paramname">file</stringProp>
                  <stringProp name="File.mimetype">application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="period" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${period}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">period</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 2xx (Upload)">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="assert_2xx">^2\d\d$</stringProp>
              </collectionProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Max Response Time (Upload)">
              <stringProp name="DurationAssertion.duration">${__P(max_resp_ms,12000)}</stringProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>

          <!-- 2) SAVE (solo si Upload OK) -->
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF Upload OK → SAVE">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <stringProp name="IfController.condition">${JMeterThread.last_sample_ok}</stringProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>

            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Breathing before SAVE">
              <stringProp name="ConstantTimer.delay">200</stringProp>
            </ConstantTimer>
            <hashTree/>

            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SAVE - Init retry">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
vars.put('SAVE_RETRY_COUNT','0')
vars.put('SAVE_SHOULD_RETRY','true')
]]></stringProp>
            </JSR223Sampler>
            <hashTree/>

            <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="SAVE - Retry loop (417)">
              <stringProp name="WhileController.condition">${SAVE_SHOULD_RETRY}</stringProp>
            </WhileController>
            <hashTree>

              <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If SAVE retry → backoff">
                <boolProp name="IfController.evaluateAll">false</boolProp>
                <stringProp name="IfController.condition">${__groovy((vars.get('SAVE_RETRY_COUNT') ?: '0') as int &gt; 0)}</stringProp>
                <boolProp name="IfController.useExpression">true</boolProp>
              </IfController>
              <hashTree>
                <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Backoff (SAVE)">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
int count = (vars.get('SAVE_RETRY_COUNT') ?: '0') as int
long base = Long.parseLong(props.getProperty('retry_417_base_ms','200'))
long sleep = (long)(base * Math.pow(2, Math.max(0, count-1))) + new java.util.Random().nextInt(200)
Thread.sleep(sleep)
]]></stringProp>
                </JSR223Sampler>
                <hashTree/>
              </hashTree>

              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Save Excel Data">
                <stringProp name="HTTPSampler.path">${__P(base_api,/api/v1)}/financial-fixed-assets?period=${period}</stringProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                <intProp name="HTTPSampler.connect_timeout">10000</intProp>
                <intProp name="HTTPSampler.response_timeout">30000</intProp>
                <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
                <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
                  <collectionProp name="Arguments.arguments"/>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>

                <!-- FIXED: JSR223PostProcessor con regex compatibles Groovy -->
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="SAVE - Retry decision (417 temporal)">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
def code    = prev.getResponseCode()
def body    = prev.getResponseDataAsString() ?: ''
def headers = prev.getResponseHeaders() ?: ''

int count   = (vars.get('SAVE_RETRY_COUNT') ?: '0') as int
int max     = Integer.parseInt(props.getProperty('retry_417_max','2'))

boolean isTemporal =
        (body    =~ /(?i)"temporary"\s*:\s*true/) ||
        (body    =~ /(?i)"type"\s*:\s*"TEMPORAL"/) ||
        (headers =~ /(?mi)^X-Error-Type:\s*TEMPORAL\s*$/)

if (code ==~ /2\d\d/) {
  vars.put('SAVE_SHOULD_RETRY','false')
} else if (code == '417' && isTemporal && count < max) {
  count++
  vars.put('SAVE_RETRY_COUNT', count.toString())
  vars.put('SAVE_SHOULD_RETRY','true')
} else {
  vars.put('SAVE_SHOULD_RETRY','false')
}
]]></stringProp>
                </JSR223PostProcessor>
                <hashTree/>

                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="SAVE - Assert 2xx (o 417 con retry)">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
def code = prev.getResponseCode()
def shouldRetry = vars.get('SAVE_SHOULD_RETRY') == 'true'
if (code ==~ /2\d\d/) { AssertionResult.setFailure(false); return }
if (code == '417' && shouldRetry) { AssertionResult.setFailure(false); prev.setSuccessful(true); return }
AssertionResult.setFailure(true)
AssertionResult.setFailureMessage("SAVE failed with code ${code} (retries=${vars.get('SAVE_RETRY_COUNT')})")
]]></stringProp>
                </JSR223Assertion>
                <hashTree/>

                <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Max Response Time (SAVE)">
                  <stringProp name="DurationAssertion.duration">${__P(max_resp_ms,12000)}</stringProp>
                </DurationAssertion>
                <hashTree/>

              </hashTree>
            </hashTree>
          </hashTree>

          <!-- 3) PROJECTION (solo si SAVE OK) -->
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF Save OK → PROJECTION">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <stringProp name="IfController.condition">${JMeterThread.last_sample_ok}</stringProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>

            <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Breathing before PROJECTION">
              <stringProp name="ConstantTimer.delay">150</stringProp>
            </ConstantTimer>
            <hashTree/>

            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="PROJ - Init retry">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
vars.put('PROJ_RETRY_COUNT','0')
vars.put('PROJ_SHOULD_RETRY','true')
]]></stringProp>
            </JSR223Sampler>
            <hashTree/>

            <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="PROJ - Retry loop (417)">
              <stringProp name="WhileController.condition">${PROJ_SHOULD_RETRY}</stringProp>
            </WhileController>
            <hashTree>

              <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If PROJ retry → backoff">
                <boolProp name="IfController.evaluateAll">false</boolProp>
                <stringProp name="IfController.condition">${__groovy((vars.get('PROJ_RETRY_COUNT') ?: '0') as int &gt; 0)}</stringProp>
                <boolProp name="IfController.useExpression">true</boolProp>
              </IfController>
              <hashTree>
                <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Backoff (PROJ)">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
int count = (vars.get('PROJ_RETRY_COUNT') ?: '0') as int
long base = Long.parseLong(props.getProperty('retry_417_base_ms','200'))
long sleep = (long)(base * Math.pow(2, Math.max(0, count-1))) + new java.util.Random().nextInt(200)
Thread.sleep(sleep)
]]></stringProp>
                </JSR223Sampler>
                <hashTree/>
              </hashTree>

              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Generate Projection">
                <stringProp name="HTTPSampler.path">${__P(base_api,/api/v1)}/financial-fixed-assets/projection?type=${projection_type}&amp;period=${period}&amp;account=${account}</stringProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                <intProp name="HTTPSampler.connect_timeout">10000</intProp>
                <intProp name="HTTPSampler.response_timeout">30000</intProp>
                <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
                <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
                  <collectionProp name="Arguments.arguments"/>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>

                <!-- FIXED: JSR223PostProcessor con regex compatibles Groovy -->
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PROJ - Retry decision (417 temporal)">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
def code    = prev.getResponseCode()
def body    = prev.getResponseDataAsString() ?: ''
def headers = prev.getResponseHeaders() ?: ''

int count   = (vars.get('PROJ_RETRY_COUNT') ?: '0') as int
int max     = Integer.parseInt(props.getProperty('retry_417_max','2'))

boolean isTemporal =
        (body    =~ /(?i)"temporary"\s*:\s*true/) ||
        (body    =~ /(?i)"type"\s*:\s*"TEMPORAL"/) ||
        (headers =~ /(?mi)^X-Error-Type:\s*TEMPORAL\s*$/)

if (code ==~ /2\d\d/) {
  vars.put('PROJ_SHOULD_RETRY','false')
} else if (code == '417' && isTemporal && count < max) {
  count++
  vars.put('PROJ_RETRY_COUNT', count.toString())
  vars.put('PROJ_SHOULD_RETRY','true')
} else {
  vars.put('PROJ_SHOULD_RETRY','false')
}
]]></stringProp>
                </JSR223PostProcessor>
                <hashTree/>

                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="PROJ - Assert 2xx (o 417 con retry)">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
def code = prev.getResponseCode()
def shouldRetry = vars.get('PROJ_SHOULD_RETRY') == 'true'
if (code ==~ /2\d\d/) { AssertionResult.setFailure(false); return }
if (code == '417' && shouldRetry) { AssertionResult.setFailure(false); prev.setSuccessful(true); return }
AssertionResult.setFailure(true)
AssertionResult.setFailureMessage("PROJ failed with code ${code} (retries=${vars.get('PROJ_RETRY_COUNT')})")
]]></stringProp>
                </JSR223Assertion>
                <hashTree/>

                <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Max Response Time (PROJECTION)">
                  <stringProp name="DurationAssertion.duration">${__P(max_resp_ms,12000)}</stringProp>
                </DurationAssertion>
                <hashTree/>

              </hashTree>
            </hashTree>
          </hashTree>

          <!-- Release lock (si se adquirió) -->
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF lock acquired → Release">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get('GLOBAL_LOCK_ACQUIRED') == 'true')}</stringProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="GLOBAL LOCK - Release">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
def obj = props.get('perf.global.lock')
if (obj instanceof java.util.concurrent.Semaphore) {
  ((java.util.concurrent.Semaphore)obj).release()
  vars.remove('GLOBAL_LOCK_ACQUIRED')
}
SampleResult.setSuccessful(true)
]]></stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>

        </hashTree>

