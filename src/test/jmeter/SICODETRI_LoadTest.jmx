def stopOnEof = (props.getProperty('csv_stop_on_eof') ?: 'true').toBoolean()
def keys = ['tax_option','tax_id','tax_accountingAccount']
def eofAny = keys.any { (vars.get(it) ?: '') == '<EOF>' }
vars.put('EOF_ANY_TAX',       String.valueOf(eofAny))
vars.put('EOF_CONTINUE_TAX',  String.valueOf(!eofAny))
vars.put('EOF_IDLE_TAX',      String.valueOf(eofAny && !stopOnEof))
SampleResult.setSuccessful(true)
]]></stringProp>
