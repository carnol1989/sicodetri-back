  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SICODETRI Perf Plan (Corrected)" enabled="true">
      <stringProp name="TestPlan.comments">CSV paths corrected to be relative. DATASET_DIR variable removed.</stringProp>
