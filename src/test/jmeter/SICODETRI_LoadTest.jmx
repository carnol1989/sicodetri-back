        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Pick Transaction by Percentages" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"/>
          <stringProp name="filename"/>
          <stringProp name="cacheKey"/>
          <stringProp name="script">
double pUpload = vars.get("pct_upload_save")?.toDouble() ?: 10d;
double pQuery  = vars.get("pct_query")?.toDouble() ?: 40d;
double pProj   = vars.get("pct_proj")?.toDouble() ?: 15d;
double pReport = vars.get("pct_report")?.toDouble() ?: 20d;
double pTax    = vars.get("pct_tax")?.toDouble() ?: 15d;
double sum = pUpload + pQuery + pProj + pReport + pTax;
if (sum &lt;= 0) { pQuery = 100; sum = 100; }
pUpload = (pUpload / sum) * 100d;
pQuery  = (pQuery  / sum) * 100d;
pProj   = (pProj   / sum) * 100d;
pReport = (pReport / sum) * 100d;
pTax    = (pTax    / sum) * 100d;
double r = Math.random() * 100d;
String choice;
if      (r &lt; pUpload)                                      choice = "TX_UPLOAD_SAVE";
else if (r &lt; pUpload + pQuery)                             choice = "TX_QUERY";
else if (r &lt; pUpload + pQuery + pProj)                     choice = "TX_PROJ";
else if (r &lt; pUpload + pQuery + pProj + pReport)           choice = "TX_REPORT";
else                                                       choice = "TX_TAX";
vars.put("tx_choice", choice);
</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <SwitchController guiclass="SwitchControllerGui" testclass="SwitchController" testname="Switch by tx_choice" enabled="true">
          <stringProp name="SwitchController.value">${tx_choice}</stringProp>
        </SwitchController>
        <hashTree/>
        <Summariser guiclass="SummariserGui" testclass="Summariser" testname="Summary Report" enabled="true"/>
        <hashTree/>
      </hashTree>
