          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${__P(files_dir,)}/report_params.csv</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">${__P(csv_stop_on_eof,true)}</boolProp>
          <stringProp name="shareMode">${__P(csv_shareMode,shareMode.current_thread)}</stringProp>
          <stringProp name="variableNames">option,fileType,year,mainCode,accountingAccount,startAcquisitionDate,endAcquisitionDate,startDateUse,endDateUse</stringProp>
        </CSVDataSet>
        <hashTree/>

        <!-- EOF flags (Reports) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Compute EOF flags (Reports)">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
def stopOnEof = (props.getProperty('csv_stop_on_eof') ?: 'true').toBoolean()
def keys = ['option','fileType','year','mainCode','accountingAccount','startAcquisitionDate','endAcquisitionDate','startDateUse','endDateUse']
def eofAny = keys.any { (vars.get(it) ?: '') == '<EOF>' }
vars.put('EOF_ANY_REP',       String.valueOf(eofAny))
vars.put('EOF_CONTINUE_REP',  String.valueOf(!eofAny))
vars.put('EOF_IDLE_REP',      String.valueOf(eofAny && !stopOnEof))
SampleResult.setSuccessful(true)
]]></stringProp>
        </JSR223Sampler>
        <hashTree/>

        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF EOF_IDLE_REP → small sleep">
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <stringProp name="IfController.condition">${EOF_IDLE_REP}</stringProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Idle sleep (Reports)">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
long ms = Long.parseLong(props.getProperty('eof_idle_ms','200'))
Thread.sleep(ms)
SampleResult.setSuccessful(true)
]]></stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>

        <!-- AUTH - OnceOnly (Reports) -->
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="AUTH - Once Only (Reports)"/>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="AUTH - Get Token (Reports)">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <AuthManager guiclass="AuthPanel" testclass="AuthManager" testname="HTTP Authorization Manager (Basic /oauth2/token) - Reports">
              <collectionProp name="AuthManager.auth_list">
                <elementProp name="" elementType="Authorization">
                  <stringProp name="Authorization.url">${__P(protocol,http)}://${__P(host,localhost)}:${__P(port,8082)}${__P(token_path,/oauth2/token)}</stringProp>
                  <stringProp name="Authorization.username">${__P(client_id,perf-client)}</stringProp>
                  <stringProp name="Authorization.password">${__P(client_secret,perf-secret)}</stringProp>
                  <stringProp name="Authorization.domain"></stringProp>
                  <stringProp name="Authorization.realm"></stringProp>
                  <stringProp name="Authorization.mechanism">BASIC</stringProp>
                </elementProp>
              </collectionProp>
              <boolProp name="AuthManager.clearEachIteration">true</boolProp>
            </AuthManager>
            <hashTree/>

            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Get Token (client_credentials) - Reports">
              <stringProp name="HTTPSampler.path">${__P(token_path,/oauth2/token)}</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
              <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
              <intProp name="HTTPSampler.connect_timeout">10000</intProp>
              <intProp name="HTTPSampler.response_timeout">30000</intProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="grant_type" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">client_credentials</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">grant_type</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header - Token Request (Reports)">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/x-www-form-urlencoded</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 2xx (Token - Reports)">
                <collectionProp name="Asserion.test_strings"><stringProp name="assert_2xx">^2\d\d$</stringProp></collectionProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
              <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Max Response Time (Token - Reports)">
                <stringProp name="DurationAssertion.duration">${__P(max_resp_ms,12000)}</stringProp>
              </DurationAssertion>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract ACCESS_TOKEN (Reports)">
                <stringProp name="JSONPostProcessor.referenceNames">ACCESS_TOKEN_REP</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp>
                <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
              </JSONPostProcessor>
              <hashTree/>

              <!-- Corte si falla token Reports -->
              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Compute TOKEN_MISSING (Reports)">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="script"><![CDATA[
def t = vars.get('ACCESS_TOKEN_REP') ?: 'TOKEN_NOT_FOUND'
vars.put('TOKEN_MISSING_REP', String.valueOf(t == 'TOKEN_NOT_FOUND'))
SampleResult.setSuccessful(true)
]]></stringProp>
              </JSR223Sampler>
              <hashTree/>
              <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If no ACCESS_TOKEN_REP → Stop">
                <boolProp name="IfController.evaluateAll">false</boolProp>
                <stringProp name="IfController.condition">${TOKEN_MISSING_REP}</stringProp>
                <boolProp name="IfController.useExpression">true</boolProp>
              </IfController>
              <hashTree>
                <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Stop Test Now (Reports)">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script"><![CDATA[
SampleResult.setSuccessful(false)
log.error('ACCESS_TOKEN_REP not found. Stopping test.')
org.apache.jmeter.engine.StandardJMeterEngine.stopTest(true)
]]></stringProp>
                </JSR223Sampler>
                <hashTree/>
              </hashTree>

            </hashTree>
          </hashTree>
        </hashTree>

        <!-- BUSINESS solo si no hay EOF -->
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF not EOF_REP → BUSINESS">
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <stringProp name="IfController.condition">${EOF_CONTINUE_REP}</stringProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>

          <!-- (1.2) Espera a que TG1 marque "report.ready.&lt;year&gt;" -->
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="WAIT until projection ready (year=${year})">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script"><![CDATA[
long maxWait = Long.parseLong(props.getProperty('reports_max_wait_ms','10000'))
long step = 200, waited = 0
def key = 'report.ready.' + (vars.get('year') ?: '')
while (waited < maxWait && props.getProperty(key) != 'true') {
  Thread.sleep(step); waited += step
}
boolean ok = (props.getProperty(key) == 'true')
vars.put('REPORT_READY', String.valueOf(ok))
SampleResult.setSuccessful(true)
if (!ok) log.warn('Projection not ready for year {} after {} ms', vars.get('year'), waited)
]]></stringProp>
          </JSR223Sampler>
          <hashTree/>

          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="IF !REPORT_READY → Stop Thread">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get('REPORT_READY') != 'true')}</stringProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Stop Thread - Projection not ready">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script"><![CDATA[
SampleResult.setSuccessful(false)
ctx.getThread().stop()
]]></stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>

          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="REPORTS - GET /financial-fixed-assets/report (option=${option})">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>

            <!-- Bearer local (Reports) -->
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header - API Auth (Reports)">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Authorization</stringProp>
                  <stringProp name="Header.value">Bearer ${ACCESS_TOKEN_REP}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>

            <!-- GET /financial-fixed-assets/report con params del CSV -->
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Report (option=${option})">
              <stringProp name="HTTPSampler.path">${__P(base_api,/api/v1)}/financial-fixed-assets/report</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
              <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
              <intProp name="HTTPSampler.connect_timeout">10000</intProp>
              <intProp name="HTTPSampler.response_timeout">30000</intProp>
              <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="option" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${option}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">option</stringProp>
                  </elementProp>
                  <elementProp name="fileType" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${fileType}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">fileType</stringProp>
                  </elementProp>
                  <elementProp name="year" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${year}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">year</stringProp>
                  </elementProp>
                  <elementProp name="mainCode" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${mainCode}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">mainCode</stringProp>
                  </elementProp>
                  <elementProp name="accountingAccount" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${accountingAccount}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">accountingAccount</stringProp>
                  </elementProp>
                  <elementProp name="startAcquisitionDate" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${startAcquisitionDate}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">startAcquisitionDate</stringProp>
                  </elementProp>
                  <elementProp name="endAcquisitionDate" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${endAcquisitionDate}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">endAcquisitionDate</stringProp>
                  </elementProp>
                  <elementProp name="startDateUse" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${startDateUse}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">startDateUse</stringProp>
                  </elementProp>
                  <elementProp name="endDateUse" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${endDateUse}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">endDateUse</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>

              <!-- (2) Bearer por-request (blindado) -->
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header - Bearer (per request)">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${ACCESS_TOKEN_REP}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">*/*</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>

              <!-- (3) Verifica que llega un attachment y no HTML -->
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert attachment (Content-Disposition)">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="script"><![CDATA[
def h = (prev.getResponseHeaders() ?: '').toLowerCase()
def ok = h.contains('content-disposition: attachment')
AssertionResult.setFailure(!ok)
if (!ok) AssertionResult.setFailureMessage('Expected attachment; got: ' + h)
]]></stringProp>
              </JSR223Assertion>
              <hashTree/>

              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert 200 (Report)">
                <collectionProp name="Asserion.test_strings"><stringProp name="assert_2xx">200</stringProp></collectionProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
              </ResponseAssertion>
              <hashTree/>
              <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Max Response Time (Report)">
                <stringProp name="DurationAssertion.duration">${__P(max_resp_ms,12000)}</stringProp>
              </DurationAssertion>
              <hashTree/>
            </hashTree>

          </hashTree>
        </hashTree>

      </hashTree>

      <!-- ================= -->
      <!-- LISTENERS (GLOBAL) -->
      <!-- ================= -->
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time><latency>true</latency><timestamp>true</timestamp>
            <success>true</success><label>true</label><code>true</code><message>true</message>
            <threadName>true</threadName><dataType>true</dataType><encoding>false</encoding>
            <assertions>true</assertions><subresults>true</subresults><responseData>false</responseData>
            <samplerData>false</samplerData><xml>false</xml><fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders><requestHeaders>false</requestHeaders>
            <responseDataOnError>true</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes><sentBytes>true</sentBytes><url>true</url>
            <threadCounts>true</threadCounts><sampleCount>true</sampleCount>
            <idleTime>true</idleTime><connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>

      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time><latency>true</latency><timestamp>true</timestamp>
            <success>true</success><label>true</label><code>true</code><message>true</message>
            <threadName>true</threadName><dataType>true</dataType><encoding>false</encoding>
            <assertions>true</assertions><subresults>true</subresults><responseData>true</responseData>
            <samplerData>true</samplerData><xml>false</xml><fieldNames>true</fieldNames>
            <responseHeaders>true</responseHeaders><requestHeaders>true</requestHeaders>
            <responseDataOnError>true</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes><sentBytes>true</sentBytes><url>true</url>
            <threadCounts>true</threadCounts><sampleCount>true</sampleCount>
            <idleTime>true</idleTime><connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>

    </hashTree>
  </hashTree>
</jmeterTestPlan>