<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- (opcional) lee propiedades de Spring -->
    <springProperty name="LOG_FILE" source="logging.file.name" defaultValue="logs/sicodetri.log"/>
    <springProperty name="LOG_LEVEL_ROOT" source="logging.level.root"   defaultValue="INFO"/>

    <!-- appender consola -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- appender fichero -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- rota cada día y conserva 30 días -->
            <fileNamePattern>logs/sicodetri-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- nivel por defecto -->
    <root level="${LOG_LEVEL_ROOT}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- override de paquetería específica -->
    <logger name="com.epsgrau.pe.sicodetri" level="DEBUG"/>
    <logger name="org.hibernate.SQL"         level="DEBUG"/>
    <logger name="org.springframework.web"   level="INFO"/>

</configuration>